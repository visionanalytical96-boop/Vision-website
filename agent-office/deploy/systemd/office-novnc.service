[Unit]
Description=noVNC web bridge for the agent office (localhost only)
After=office-vnc.service
Requires=office-vnc.service

[Service]
User=@USER@
# Bound to 127.0.0.1: open it with  ssh -L @NOVNC_PORT@:localhost:@NOVNC_PORT@
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:@NOVNC_PORT@ 127.0.0.1:@VNC_PORT@
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
