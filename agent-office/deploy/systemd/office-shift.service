[Unit]
Description=Vision Analytical - run the daily desk (headless harness)
After=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@HARNESS_DIR@
# The harness talks to the API directly, so it needs a key of its own. The GUI
# does not: it drives the Claude Code CLI, which carries its own login.
EnvironmentFile=-/etc/agent-office.env
ExecStart=/usr/bin/env node bin/office.mjs run --shift daily
