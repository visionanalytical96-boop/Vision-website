[Unit]
Description=Virtual display for the Vision Analytical agent office
Documentation=https://github.com/chaitanyagiri/munder-difflin
After=network.target

[Service]
User=@USER@
ExecStart=/usr/bin/Xvfb @DISPLAY@ -screen 0 @GEOMETRY@ -nolisten tcp -ac
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
