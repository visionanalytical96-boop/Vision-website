# BharatStay — environment variables
# Copy to .env.local and fill in real values only for providers you actually connect.
# Never commit real secrets. All values below are placeholders.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Signs the session cookie. Generate with: openssl rand -base64 32
JWT_SECRET=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/bharatstay

# --- Admin account ---
# Seeded on first `prisma db seed`. The password is stored as an argon2id hash;
# the plaintext never reaches the database or the browser.
# Minimum 12 characters — the seed refuses weak or well-known values.
# Generate one with: openssl rand -base64 24
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Messaging providers ---
# mock  = login codes are returned to the screen (offline demo, no SMS sent)
# msg91 = real SMS, requires SMS_API_KEY and SMS_SENDER_ID
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Payments ---
# Payments are direct UPI: the owner sets their UPI ID in the admin panel
# (Site settings), the customer scans a QR or taps through to their UPI app,
# and the admin verifies the UTR against the bank statement. No gateway, no
# merchant account and no keys are involved.

# --- Google Maps ---
# Enable Maps JavaScript API + Places on a Google Cloud project with billing,
# then paste the browser key here. Without it the site draws its own map and
# everything still works.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- GST invoicing ---
GST_NUMBER=
