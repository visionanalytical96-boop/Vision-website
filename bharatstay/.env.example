# BharatStay — environment variables
# Copy to .env.local and fill in real values only for providers you actually connect.
# Never commit real secrets. All values below are placeholders.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
JWT_SECRET=
SESSION_SECRET=

# --- Database & cache ---
DATABASE_URL=postgresql://user:password@localhost:5432/bharatstay
REDIS_URL=redis://localhost:6379

# --- Object storage (property images, KYC docs, generated PDFs) ---
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payment gateways (select active one via PAYMENT_PROVIDER) ---
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=

# --- Messaging providers ---
SMS_PROVIDER=mock
SMS_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_API_TOKEN=
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@bharatstay.example

# --- Maps ---
MAPS_PROVIDER_API_KEY=

# --- GST invoicing ---
GST_INVOICE_PROVIDER=mock
GST_NUMBER=

# --- Travel insurance ---
INSURANCE_PROVIDER=mock
INSURANCE_API_KEY=

# --- IRCTC-authorised rail data partner (readiness only, not connected) ---
RAIL_PROVIDER=mock
RAIL_PARTNER_API_KEY=
