{
  "name": "bharatstay",
  "version": "0.1.0",
  "private": true,
  "description": "BharatStay \u2014 Maharashtra ke stays, restaurants aur weekend trips",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && cp -r public .next/standalone/ 2>/dev/null; cp -r .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs",
    "release": "prisma migrate deploy && node prisma/seed.mjs",
    "extract-content": "node scripts/extract-content.mjs",
    "e2e": "node scripts/e2e.mjs",
    "import-photos": "node --env-file-if-exists=.env scripts/import-photos.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "jose": "^6.2.7",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.4",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "prisma": "^5.16.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
