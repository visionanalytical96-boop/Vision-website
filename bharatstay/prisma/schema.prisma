// BharatStay — Maharashtra stays, restaurants and weekend trips.
//
// Scope note: flights, buses, trains and coupons were removed from the product.
// What remains is what the site actually sells: stays, restaurants, packages,
// activities and cabs, plus the partner-onboarding and admin-editing machinery.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts

enum UserRole {
  ADMIN
  PARTNER
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  role         UserRole  @default(CUSTOMER)
  name         String
  email        String?   @unique
  phone        String?   @unique
  // Only ever set for ADMIN accounts; argon2id hash, never a plaintext password.
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings Booking[]
  reviews  Review[]

  @@index([role])
}

/// Short-lived login codes. The code itself is stored hashed so a database
/// dump cannot be replayed into someone's account.
model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// ---------------------------------------------------------------- catalogue

enum StayType {
  HOTEL
  RESORT
  VILLA
  HOMESTAY
  FARM_STAY
}

model Destination {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  state   String
  tone    String
  emoji   String
  desc    String
  price   Int
  count   Int
  lat     Float?
  lng     Float?
  visible Boolean @default(true)
  sort    Int     @default(0)

  @@index([visible])
}

model Stay {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  type      StayType
  city      String
  area      String
  address   String
  star      Int      @default(3)
  tone      String   @default("forest")
  room      String
  meal      String
  amenities String[]

  /// Rupees. `basePrice` is the strike-through rate, `price` is what is charged.
  basePrice Int
  price     Int
  taxPct    Int @default(12)

  rating      Float   @default(4.0)
  reviewCount Int     @default(0)
  freeCancel  Boolean @default(true)
  payAtHotel  Boolean @default(false)
  couple      Boolean @default(true)
  family      Boolean @default(true)

  lat     Float?
  lng     Float?
  visible Boolean @default(true)
  sort    Int     @default(0)

  /// Set when the listing came in through the partner form rather than the seed.
  applicationId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos   Photo[]
  bookings Booking[]
  reviews  Review[]

  @@index([city, visible])
  @@index([visible, price])
}

model Restaurant {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  city    String
  area    String
  address String
  cuisine String
  vegType String
  hours   String
  emoji   String @default("🍽️")
  tone    String @default("saffron")

  /// Typical cost for two, in rupees.
  costForTwo Int
  rating     Float   @default(4.0)
  visible    Boolean @default(true)
  sort       Int     @default(0)

  lat Float?
  lng Float?

  applicationId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos Photo[]

  @@index([city, visible])
}

model Package {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  dest      String
  tone      String
  emoji     String
  nights    Int
  days      Int
  hotel     String
  meal      String
  transport String
  sights    String[]
  price     Int
  visible   Boolean  @default(true)
  sort      Int      @default(0)

  photos   Photo[]
  bookings Booking[]
}

model Activity {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  city     String
  tone     String
  emoji    String
  hours    Int
  category String
  price    Int
  visible  Boolean @default(true)
  sort     Int     @default(0)

  photos Photo[]
}

model Cab {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  icon      String
  seats     Int
  bags      Int
  perKm     Int
  allowance Int
  category  String
  visible   Boolean @default(true)
  sort      Int     @default(0)
}

/// Badlapur → Karjat weekend planner content.
model WeekendSpot {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  place   String
  scene   String
  tone    String
  dist    String
  tag     String
  desc    String
  lat     Float?
  lng     Float?
  visible Boolean @default(true)
  sort    Int     @default(0)

  photos Photo[]
}

model WeekendPlan {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  price   Int
  per     String
  /// [["7:00 AM", "Badlapur station se shuru"], ...]
  steps   Json
  visible Boolean @default(true)
  sort    Int     @default(0)
}

// ---------------------------------------------------------------- photos

/// Image bytes live in Postgres rather than on a volume so that uploads survive
/// redeploys and behave identically in local dev. Everything is resized on the
/// way in, so rows stay small.
model Photo {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  width     Int
  height    Int
  bytes     Int
  alt       String   @default("")
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  stayId        String?
  restaurantId  String?
  packageId     String?
  activityId    String?
  weekendSpotId String?
  applicationId String?

  stay        Stay?               @relation(fields: [stayId], references: [id], onDelete: Cascade)
  restaurant  Restaurant?         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  package     Package?            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  activity    Activity?           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  weekendSpot WeekendSpot?        @relation(fields: [weekendSpotId], references: [id], onDelete: Cascade)
  application PartnerApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([stayId, sort])
  @@index([restaurantId, sort])
  @@index([applicationId])
}

// ------------------------------------------------- partner onboarding form

enum ApplicationKind {
  STAY
  RESTAURANT
}

enum ApplicationStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
}

/// Filled in by a farmhouse/hotel/restaurant owner through the public link at
/// /partner/apply. Nothing here is visible on the site until an admin approves
/// it, at which point a Stay or Restaurant row is created from these fields.
model PartnerApplication {
  id     String            @id @default(cuid())
  kind   ApplicationKind
  status ApplicationStatus @default(PENDING)

  /// Unguessable token the applicant uses to check status without an account.
  publicToken String @unique

  businessName String
  ownerName    String
  email        String
  phone        String
  city         String
  area         String
  address      String
  description  String

  // Stay-shaped fields
  stayType  StayType?
  rooms     Int?
  maxGuests Int?
  roomName  String?
  mealPlan  String?
  amenities String[] @default([])

  // Restaurant-shaped fields
  cuisine    String?
  vegType    String?
  hours      String?
  costForTwo Int?

  /// Asking price per night (stays). Admin can change it before or after approval.
  price Int?

  /// Filled in by the admin when rejecting or asking for more information.
  adminNote    String?
  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos Photo[]

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- bookings

enum BookingKind {
  STAY
  PACKAGE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id     String        @id @default(cuid())
  ref    String        @unique
  kind   BookingKind
  status BookingStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestName  String
  guestEmail String
  guestPhone String

  stayId    String?
  stay      Stay?    @relation(fields: [stayId], references: [id], onDelete: SetNull)
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  checkIn  DateTime?
  checkOut DateTime?
  nights   Int       @default(1)
  guests   Int       @default(2)
  rooms    Int       @default(1)

  baseAmount  Int
  addonAmount Int @default(0)
  taxAmount   Int
  totalAmount Int

  gstin       String?
  gstCompany  String?
  paymentMode String  @default("mock")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Review {
  id    String @id @default(cuid())
  name  String
  city  String
  stars Int
  kind  String
  text  String
  tone  String @default("forest")
  emoji String @default("👤")

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  stayId String?
  stay   Stay?   @relation(fields: [stayId], references: [id], onDelete: Cascade)

  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- site admin

/// Lets the admin switch whole sections of the site on and off. A disabled
/// service disappears from navigation, search and the sitemap.
model ServiceToggle {
  key     String  @id
  label   String
  enabled Boolean @default(true)
  sort    Int     @default(0)
}

/// Free-form key/value site settings (brand text, hero copy, contact email,
/// GSTIN, admin notes) so copy changes do not need a redeploy.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
