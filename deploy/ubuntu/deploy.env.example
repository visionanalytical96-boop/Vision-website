# Copy this file to deploy.env and fill in the values for your server.
# deploy.env contains a Syncthing API key — keep it out of git (already
# gitignored) and `chmod 600` it.

# Syncthing's local REST API. Find the API key in the Syncthing web UI
# under Settings > General > "API Key", or in ~/.config/syncthing/config.xml.
SYNCTHING_URL="http://127.0.0.1:8384"
SYNCTHING_API_KEY="changeme"

# --- Vision Analytical (static HTML) ---
# Folder ID as configured in Syncthing (Settings on the folder, not the path).
VISION_ANALYTICAL_FOLDER_ID="changeme"
VISION_ANALYTICAL_STAGING="/opt/apps/vision-analytical"
VISION_ANALYTICAL_RELEASES="/opt/live/vision-analytical/releases"
# nginx's `root` should point at this symlink, not at a specific release.
VISION_ANALYTICAL_CURRENT="/opt/live/vision-analytical/current"
VISION_ANALYTICAL_REQUIRED_FILES="index.html"
VISION_ANALYTICAL_OWNER="www-data:www-data"
VISION_ANALYTICAL_RELOAD_CMD="nginx -t && systemctl reload nginx"
# Optional. Leave empty to skip. Polled every 2s; needs 3 consecutive passes
# within 30s or the release is automatically rolled back. Must target the
# right vhost, e.g.:
# VISION_ANALYTICAL_HEALTHCHECK_CMD="curl -fsS -o /dev/null -H 'Host: visionanalytical.example.com' http://127.0.0.1/"
VISION_ANALYTICAL_HEALTHCHECK_CMD=""

# --- BharatStay (Docker Compose / Next.js) ---
BHARATSTAY_FOLDER_ID="changeme"
BHARATSTAY_STAGING="/opt/apps/bharatstay"
BHARATSTAY_RELEASES="/opt/live/bharatstay/releases"
BHARATSTAY_CURRENT="/opt/live/bharatstay/current"
# Space-separated, relative to the staging root. Adjust to your project layout.
BHARATSTAY_REQUIRED_FILES="docker-compose.yml package.json"
BHARATSTAY_OWNER="root:root"

# Validated with `docker compose config -q` before every deploy attempt, so a
# broken compose file never reaches the live symlink.
BHARATSTAY_CONFIG_CHECK_CMD="docker compose config -q"

# Run from inside $BHARATSTAY_CURRENT. If any of these paths (relative to the
# release root) changed since the previous release, deploy.sh rebuilds the
# image. Otherwise it force-recreates the containers without rebuilding —
# fast, but still picks up any bind-mounted content/env changes.
BHARATSTAY_BUILD_TRIGGER_FILES="Dockerfile docker-compose.yml package.json package-lock.json yarn.lock pnpm-lock.yaml next.config.js next.config.mjs tsconfig.json .dockerignore"
BHARATSTAY_BUILD_CMD="docker compose up -d --build"
BHARATSTAY_FAST_RELOAD_CMD="docker compose up -d --force-recreate"

# Optional. Polled every 2s; needs 3 consecutive passes within 30s or the
# release is automatically rolled back (rollback always rebuilds via
# BHARATSTAY_BUILD_CMD from the previous release, so it doesn't depend on a
# stale image tag still existing).
BHARATSTAY_HEALTHCHECK_CMD="docker compose ps --status running --quiet | grep -q ."

# Releases kept per site (for rollback); older ones are pruned after a
# successful deploy. Each release is also the timestamped backup.
KEEP_RELEASES=5

LOG_DIR="/var/log/site-deploy"
