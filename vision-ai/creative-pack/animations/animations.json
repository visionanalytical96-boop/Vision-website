    {"id": "glass_glide",      "label": "Glass Glide",      "camera": {"type": "pan_h",    "z_from": 1.13, "z_to": 1.08, "dir": -1},      "layer": {"type": "sweep",      "delay": 0.50, "duration": 1.8}}
  ]
