# Copy to .env for local (non-Docker) development. For docker compose, use
# deploy/.env.example instead - it's a self-contained env file for the
# whole stack (Postgres credentials, app settings, Cloudflare Tunnel token).
#
# Every variable below is read by the application. Nothing here is aspirational:
# if a setting is not listed, the code does not look for it.

# --- Required -------------------------------------------------------------

# PostgreSQL connection string. In docker-compose this points at the
# `postgres` service; for local dev it points at wherever Postgres runs.
DATABASE_URL="postgresql://vision_analytical:changeme@localhost:5432/vision_analytical?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
# Changing it logs everyone out, which is also how you revoke every session.
SESSION_SECRET="changeme-generate-a-32-byte-random-secret"

# --- Public site settings -------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read at runtime. In Docker they must be passed as build args (compose
# already does this) or the built image ignores them.

# Canonical public site URL, no trailing slash. Used for metadata, sitemap.xml,
# robots.txt, canonical/OG tags and the Content-Security-Policy.
NEXT_PUBLIC_SITE_URL="https://visionanalytical.co.in"

# Contact channels surfaced in the nav, footer, and quote/CTA buttons. These
# are fallbacks: once Business Settings is filled in through the admin, the
# database values win.
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"
NEXT_PUBLIC_CONTACT_PHONE="+91 XXXXX XXXXX"

# --- Seeding (first run only) ---------------------------------------------

# One-time admin bootstrap for `npx prisma db seed`. There is deliberately no
# default password: with SEED_ADMIN_PASSWORD unset the seed creates no admin
# at all, so no known-password account can ever ship. Unset it again after the
# first successful login.
SEED_ADMIN_EMAIL="admin@visionanalytical.co.in"
SEED_ADMIN_PASSWORD=""

# Optional: seeds a demo customer and engineer login plus a sample order,
# quote, service request, AMC contract and invoice. Leave "false" in
# production - this is sample data, for local development and demos only.
SEED_DEMO_DATA="false"
SEED_DEMO_PASSWORD="Demo1234!"

# --- Not used -------------------------------------------------------------
# Earlier drafts listed UPLOAD_DIR, REDIS_URL and CONTACT_EMAIL. No code reads
# them and they have been removed rather than left to mislead:
#   - uploads always go to public/uploads/ (a Docker volume in production)
#   - rate limiting is in-process (src/lib/rate-limit.ts); there is no Redis
#   - the contact email lives in Business Settings in the database

# --- Email (password reset) -------------------------------------------------
# Without these the forgot-password form says so plainly rather than silently
# dropping the mail. Zoho: create an app-specific password, not your login one.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=visionanalytical96@gmail.com
SMTP_PASSWORD=
# Optional. Defaults to SMTP_USER. Must be an address the account may send as.
SMTP_FROM=
