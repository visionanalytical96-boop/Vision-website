# Copy to .env for local development. In Docker Compose, these are supplied
# by the `app` service's env_file / environment block instead (see deploy/).

# PostgreSQL connection string. In docker-compose this points at the
# `postgres` service; for local dev it points at wherever Postgres runs.
DATABASE_URL="postgresql://vision_analytical:changeme@localhost:5432/vision_analytical?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="changeme-generate-a-32-byte-random-secret"

# Canonical public site URL, no trailing slash. Used for metadata, sitemap.xml,
# robots.txt and canonical/OG tags.
NEXT_PUBLIC_SITE_URL="https://visionanalytical.co.in"

# Contact channels surfaced in the nav, footer, and quote/CTA buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"
NEXT_PUBLIC_CONTACT_PHONE="+91 XXXXX XXXXX"
CONTACT_EMAIL="info@visionanalytical.co.in"

# Local disk path for uploaded files (product images, service reports,
# signatures, blog covers). Mounted as a Docker volume in production.
UPLOAD_DIR="./uploads"

# Redis connection string (caching, rate limiting).
REDIS_URL="redis://localhost:6379"

# One-time admin bootstrap for `npx prisma db seed`. Only used the first time
# (skipped if the account already exists) - unset after first deploy.
SEED_ADMIN_EMAIL="admin@visionanalytical.co.in"
SEED_ADMIN_PASSWORD=""
