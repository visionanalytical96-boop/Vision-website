# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# This subproject uses npm (isolated from the repo root's pnpm workspace),
# so its lockfile is intentionally committed - override the root .gitignore's
# blanket "**/package-lock.json" rule (that rule targets the pnpm workspace).
!package-lock.json
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local file uploads (dev)
/uploads

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
