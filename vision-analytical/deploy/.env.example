# Copy to deploy/.env before running docker compose. This is the complete
# environment for the stack - Postgres credentials, app settings, and the
# Cloudflare Tunnel token all live here (kept separate from the ../.env used
# for local, non-Docker development).

# --- Postgres (used by the `postgres` service; DATABASE_URL is built from
# these automatically in docker-compose.yml - don't set DATABASE_URL here) ---
POSTGRES_USER="vision_analytical"
POSTGRES_PASSWORD="changeme-generate-a-strong-password"
POSTGRES_DB="vision_analytical"

# --- App settings (see ../.env.example for what each one does) ---
SESSION_SECRET="changeme-generate-a-32-byte-random-secret"
NEXT_PUBLIC_SITE_URL="https://visionanalytical.co.in"
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"
NEXT_PUBLIC_CONTACT_PHONE="+91 XXXXX XXXXX"

# One-time admin bootstrap for the `migrate` service's seed step. There is no
# default: leave SEED_ADMIN_PASSWORD empty and the seed creates no admin at
# all, so no known-password account can ever ship. Set it for the first
# deploy, then unset it once you have logged in.
SEED_ADMIN_EMAIL="admin@visionanalytical.co.in"
SEED_ADMIN_PASSWORD=""

# Leave "false" in production - this seeds a demo login and sample records.
SEED_DEMO_DATA="false"
SEED_DEMO_PASSWORD="Demo1234!"

# --- Cloudflare Tunnel ---
# Zero Trust > Networks > Tunnels > create a tunnel > Docker connector.
# Cloudflare gives you a token for the `cloudflared tunnel run --token ...`
# command - paste just the token value here. Set the tunnel's Public
# Hostname to point at http://nginx:80 (the internal compose service).
CLOUDFLARE_TUNNEL_TOKEN=""
