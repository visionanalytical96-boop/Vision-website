// Prisma schema for the Vision Analytical platform.
// See prisma.config.ts for CLI/config wiring (Prisma 7 config format).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ENGINEER
  CUSTOMER
}

enum CategoryKind {
  INSTRUMENT
  SPARE_PART
  REFURBISHED
}

enum ProductKind {
  INSTRUMENT
  SPARE_PART
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum RefurbishedCondition {
  EXCELLENT
  GOOD
  FAIR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ServiceRequestType {
  INSTALLATION
  PREVENTIVE_MAINTENANCE
  BREAKDOWN
  CALIBRATION
  IQ
  OQ
  PQ
  VALIDATION
  SOFTWARE_INSTALL
  TRAINING
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum AmcType {
  AMC
  CMC
}

enum AmcStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
}

/// The topic a knowledge article sits under. Separate from ArticleKind: kind
/// is the *shape* of the content (a FAQ, an error code, a video), category is
/// what it is about.
enum BlogCategory {
  TROUBLESHOOTING
  FAQ
  TECHNICAL_ARTICLE
  INSTRUMENT_GUIDE
}

/// What kind of thing an article is. Drives how it's presented and where it
/// surfaces - an ERROR_CODE article is reachable from the error-code lookup, a
/// VIDEO renders its player, a FAQ is short-form.
enum ArticleKind {
  ARTICLE
  GUIDE
  FAQ
  TROUBLESHOOTING
  ERROR_CODE
  CASE_STUDY
  VIDEO
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RETURN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  name         String
  phone        String?
  companyName  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses           Address[]
  orders              Order[]          @relation("CustomerOrders")
  quotes              Quote[]          @relation("CustomerQuotes")
  serviceRequests     ServiceRequest[] @relation("CustomerServiceRequests")
  assignedServiceJobs ServiceRequest[] @relation("EngineerServiceRequests")
  serviceReports      ServiceReport[]  @relation("EngineerServiceReports")
  amcContracts        AmcContract[]    @relation("CustomerAmcContracts")
  invoices            Invoice[]        @relation("CustomerInvoices")
  assignedLeads       CrmLead[]        @relation("AssignedLeads")
  crmActivities       CrmActivity[]    @relation("CreatedActivities")
  articles            KnowledgeArticle[] @relation("AuthoredArticles")
  employeeProfile     Employee?        @relation("EmployeeAccount")
  auditEntries        AuditLog[]       @relation("AuditActor")
  stockMovements      StockMovement[]  @relation("RecordedMovements")

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Manufacturers whose instruments Vision Analytical sells and services.
/// A real entity rather than a free-text field so brands can carry logos, copy
/// and SEO, own a hub page, and be filtered on across the catalogue.
model Brand {
  id             String  @id @default(cuid())
  name           String  @unique
  slug           String  @unique
  logoUrl        String?
  description    String?
  website        String?
  sortOrder      Int     @default(0)
  isPublished    Boolean @default(true)
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products               Product[]
  refurbishedInstruments RefurbishedInstrument[]
  downloads              Download[]
  instrumentModels       InstrumentModel[]
  compatibility          ProductCompatibility[]
  articleLinks           KnowledgeArticleLink[]

  @@index([sortOrder])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  // Unique per kind, not globally: "HPLC" is a valid slug for both an
  // instrument category and a refurbished-instrument category.
  slug        String
  kind        CategoryKind
  description String?
  parentId    String?
  parent      Category?    @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryToSubcategory")
  sortOrder   Int          @default(0)

  products               Product[]
  refurbishedInstruments RefurbishedInstrument[]
  downloads              Download[]
  instrumentModels       InstrumentModel[]

  @@unique([slug, kind])
  @@index([kind])
}

model Product {
  id               String      @id @default(cuid())
  sku              String      @unique
  slug             String      @unique
  name             String
  kind             ProductKind
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?      @relation(fields: [brandId], references: [id])
  description      String
  images           Json
  priceMinor       Int?
  stockStatus      StockStatus @default(IN_STOCK)
  stockQuantity    Int         @default(0)
  isPublished      Boolean     @default(true)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  orderItems      OrderItem[]
  quoteItems      QuoteItem[]
  stockMovements  StockMovement[]
  specifications  ProductSpecification[]
  compatibility   ProductCompatibility[]
  documents       Download[]
  articleLinks    KnowledgeArticleLink[]

  @@index([kind])
  @@index([categoryId])
  @@index([brandId])
  @@index([stockStatus])
}

// ---------------------------------------------------------------------------
// Compatibility: which parts fit which instruments
// ---------------------------------------------------------------------------

/// A specific instrument a customer owns, e.g. "Alliance e2695". Spare parts
/// hang off this, and so will customer-owned instruments, calibration records
/// and service history when those modules land.
model InstrumentModel {
  id          String    @id @default(cuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  // The technique it belongs to, so a model can be browsed like a product.
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  description String?
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  compatibility ProductCompatibility[]
  articleLinks  KnowledgeArticleLink[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([categoryId])
}

/// One compatibility claim: this part fits this brand, optionally narrowed to
/// one model. A row with no model is a universal fitting ("fits Waters HPLC
/// systems generally"), which is how a lot of consumables are actually sold -
/// so the parts finder returns both model-specific and brand-wide matches.
model ProductCompatibility {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  instrumentModelId String?
  instrumentModel   InstrumentModel? @relation(fields: [instrumentModelId], references: [id], onDelete: Cascade)
  note              String?

  @@index([productId])
  @@index([brandId])
  @@index([instrumentModelId])
}

/// Structured specs rather than prose, so they can be tabulated, compared and
/// later filtered on. `group` lets a long sheet break into sections.
model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String?
  label     String
  value     String
  unit      String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model RefurbishedInstrument {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id])
  brandId             String
  brand               Brand                @relation(fields: [brandId], references: [id])
  model               String?
  condition           RefurbishedCondition
  includedAccessories String[]
  warrantyMonths      Int
  demoVideoUrl        String?
  description         String
  images              Json
  priceMinor          Int?
  stockStatus         StockStatus          @default(IN_STOCK)
  isPublished         Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  orderItems OrderItem[]
  quoteItems QuoteItem[]

  @@index([categoryId])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Commerce: quotes -> orders -> invoices
// ---------------------------------------------------------------------------

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  customerId    String?
  customer      User?       @relation("CustomerQuotes", fields: [customerId], references: [id])
  contactName   String
  contactEmail  String
  contactPhone  String?
  status        QuoteStatus @default(REQUESTED)
  validUntil    DateTime?
  totalMinor    Int?
  notes         String?
  poNumber      String?
  poDocumentUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items QuoteItem[]
  order Order?

  @@index([customerId])
  @@index([status])
}

model QuoteItem {
  id                      String                 @id @default(cuid())
  quoteId                 String
  quote                   Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  refurbishedInstrumentId String?
  refurbishedInstrument   RefurbishedInstrument? @relation(fields: [refurbishedInstrumentId], references: [id], onDelete: SetNull)
  description             String
  quantity                Int
  unitPriceMinor          Int?

  @@index([quoteId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  status          OrderStatus @default(PENDING)
  subtotalMinor   Int
  totalMinor      Int
  shippingAddress Json
  billingAddress  Json
  poNumber        String?
  poDocumentUrl   String?
  notes           String?
  sourceQuoteId   String?     @unique
  sourceQuote     Quote?      @relation(fields: [sourceQuoteId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id                      String                 @id @default(cuid())
  orderId                 String
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  refurbishedInstrumentId String?
  refurbishedInstrument   RefurbishedInstrument? @relation(fields: [refurbishedInstrumentId], references: [id], onDelete: SetNull)
  nameSnapshot            String
  skuSnapshot             String?
  unitPriceMinor          Int
  quantity                Int
  lineTotalMinor          Int

  @@index([orderId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  customer      User          @relation("CustomerInvoices", fields: [customerId], references: [id])
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  amcContractId String?
  amcContract   AmcContract?  @relation(fields: [amcContractId], references: [id])
  amountMinor   Int
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  pdfUrl        String?

  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Service: requests -> reports, AMC/CMC contracts
// ---------------------------------------------------------------------------

model ServiceRequest {
  id                    String               @id @default(cuid())
  ticketNumber          String               @unique
  customerId            String
  customer              User                 @relation("CustomerServiceRequests", fields: [customerId], references: [id])
  type                  ServiceRequestType
  priority              Priority             @default(NORMAL)
  status                ServiceRequestStatus @default(OPEN)
  instrumentDescription String
  description           String
  assignedEngineerId    String?
  assignedEngineer      User?                @relation("EngineerServiceRequests", fields: [assignedEngineerId], references: [id])
  amcContractId         String?
  amcContract           AmcContract?         @relation(fields: [amcContractId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  resolvedAt            DateTime?

  reports ServiceReport[]

  @@index([customerId])
  @@index([assignedEngineerId])
  @@index([status])
}

model ServiceReport {
  id                   String         @id @default(cuid())
  serviceRequestId     String
  serviceRequest       ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  engineerId           String
  engineer             User           @relation("EngineerServiceReports", fields: [engineerId], references: [id])
  workPerformed        String
  partsUsed            Json
  photos               Json
  customerSignatureUrl String?
  reportedAt           DateTime       @default(now())

  @@index([serviceRequestId])
}

model AmcContract {
  id                    String    @id @default(cuid())
  contractNumber        String    @unique
  customerId            String
  customer              User      @relation("CustomerAmcContracts", fields: [customerId], references: [id])
  type                  AmcType
  instrumentDescription String
  startDate             DateTime
  endDate               DateTime
  visitsIncluded        Int
  visitsUsed            Int       @default(0)
  priceMinor            Int?
  status                AmcStatus @default(ACTIVE)
  createdAt             DateTime  @default(now())

  serviceRequests ServiceRequest[]
  invoices        Invoice[]

  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model CrmLead {
  id                  String        @id @default(cuid())
  name                String
  company             String?
  email               String?
  phone               String?
  source              String?
  status              CrmLeadStatus @default(NEW)
  assignedToId        String?
  assignedTo          User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes               String?
  convertedCustomerId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  activities CrmActivity[]

  @@index([status])
  @@index([assignedToId])
}

model CrmActivity {
  id          String          @id @default(cuid())
  leadId      String
  lead        CrmLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        CrmActivityType
  notes       String
  createdById String
  createdBy   User            @relation("CreatedActivities", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

/// The editorial lifecycle every piece of knowledge content moves through.
/// A two-state boolean can't express review or archival, and "archived" is not
/// the same as "never published" - the difference matters for an audit trail.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// A piece of knowledge: article, guide, FAQ, troubleshooting note, error code,
/// case study or video. Mapped to the original `BlogPost` table - the name was
/// outgrown, not the data, so this is a code-level rename with no migration.
model KnowledgeArticle {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  content        String
  kind           ArticleKind   @default(ARTICLE)
  category       BlogCategory
  coverImage     String?
  /// VIDEO articles embed this; any article may also link one.
  videoUrl       String?
  /// The manufacturer's code this article explains, e.g. "E-1201". Unique per
  /// brand rather than globally: two manufacturers reuse the same numbers.
  errorCode      String?
  authorId       String
  author         User          @relation("AuthoredArticles", fields: [authorId], references: [id])
  status         ContentStatus @default(DRAFT)
  /// When set in the future, the article stays hidden until that moment even at
  /// status PUBLISHED - which is what makes scheduling possible without a job
  /// runner: visibility is a query condition, not a timer.
  publishAt      DateTime?
  publishedAt    DateTime?
  reviewNote     String?
  seoTitle       String?
  seoDescription String?
  /// Feeds "popular articles". Incremented best-effort on read.
  viewCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  links KnowledgeArticleLink[]

  @@index([category])
  @@index([kind])
  @@index([status])
  @@index([publishAt])
  @@index([errorCode])
  @@map("BlogPost")
}

/// What an article is about. One row per target so an article can cover a
/// brand, one of its models and a specific part at once - the same shape as
/// ProductCompatibility, for the same reason.
model KnowledgeArticleLink {
  id                String           @id @default(cuid())
  articleId         String
  article           KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  brandId           String?
  brand             Brand?           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  instrumentModelId String?
  instrumentModel   InstrumentModel? @relation(fields: [instrumentModelId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([brandId])
  @@index([instrumentModelId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Feature flags - the admin turns modules on and off without a deploy
// ---------------------------------------------------------------------------

/// Keyed by a stable string rather than an enum: a flag is configuration, and
/// adding one should never need a migration. Unknown keys resolve to their
/// coded default, so a flag row that hasn't been seeded yet is not an outage.
model FeatureFlag {
  key         String   @id
  label       String
  description String?
  group       String
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([group, sortOrder])
}

// ---------------------------------------------------------------------------
// Site CMS - homepage sections, other page content, and site-wide settings
// editable from the admin panel without a code change. `content` fields are
// Json validated with Zod on read (see src/lib/cms/*) since Prisma can't
// express their shape at the schema level.
// ---------------------------------------------------------------------------

enum HomeSectionKey {
  HERO
  CATEGORIES
  LIFECYCLE
  WHY_US
  CTA
  COMPANY_OVERVIEW
  FEATURED_PRODUCTS
  BRANDS
  INDUSTRIES
  KNOWLEDGE
  TESTIMONIALS
  CONTACT_BAND
}

model HomeSection {
  id        String         @id @default(cuid())
  key       HomeSectionKey @unique
  isVisible Boolean        @default(true)
  sortOrder Int            @default(0)
  content   Json
  updatedAt DateTime       @updatedAt

  @@index([sortOrder])
}

enum ContentPageKey {
  ABOUT
  SERVICES
  CONTACT
  HEADER
  FOOTER
  ANNOUNCEMENT
}

model PageContent {
  id        String         @id @default(cuid())
  page      ContentPageKey @unique
  content   Json
  updatedAt DateTime       @updatedAt
}

// Singleton row (id is always the literal string "singleton").
model SiteSettings {
  id                    String   @id @default("singleton")
  companyName           String   @default("Vision Analytical")
  addressLine           String?
  city                  String?
  state                 String?
  country               String   @default("India")
  phone                 String?
  whatsappNumber        String?
  email                 String?
  facebookUrl           String?
  instagramUrl          String?
  linkedinUrl           String?
  youtubeUrl            String?
  seoDefaultTitle       String?
  seoDefaultDescription String?
  logoUrl               String?
  faviconUrl            String?
  updatedAt             DateTime @updatedAt
}

// Singleton row (id is always the literal string "singleton").
model ThemeSettings {
  id                String   @id @default("singleton")
  primaryColor      String   @default("#2563eb")
  secondaryColor    String   @default("#0891b2")
  fontHeading       String   @default("space-grotesk")
  fontBody          String   @default("inter")
  buttonStyle       String   @default("rounded")
  animationsEnabled Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Int
  reference   String?
  note        String?
  createdById String
  createdBy   User              @relation("RecordedMovements", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Knowledge assets: downloadable datasheets, manuals and certificates
// ---------------------------------------------------------------------------

enum DownloadKind {
  DATASHEET
  MANUAL
  BROCHURE
  CATALOGUE
  APPLICATION_NOTE
  CERTIFICATE
  SOFTWARE
}

model Download {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  kind        DownloadKind
  fileUrl     String
  // Null when the file is hosted off-site and we can't measure it.
  fileSizeBytes Int?
  fileType    String?
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  // Attaching a document to a product puts it on that product's page as well
  // as in the downloads centre.
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Some manufacturer documents may only be released to known customers.
  requiresLogin Boolean    @default(false)
  downloadCount Int        @default(0)
  isPublished Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kind])
  @@index([brandId])
  @@index([categoryId])
  @@index([productId])
  @@index([isPublished])
}

// ---------------------------------------------------------------------------
// Misc
// ---------------------------------------------------------------------------

model Testimonial {
  id          String   @id @default(cuid())
  quote       String
  authorName  String
  authorTitle String?
  company     String?
  logoUrl     String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Team: employees, attendance, leave
//
// Designed as the base for HRMS, payroll and asset tracking rather than a
// standalone attendance page. Two rules shape it:
//
//  1. An Employee is not a User. Field staff often have no login, and most
//     Users (customers) are not employees, so the link is optional on both
//     sides rather than folding HR data onto the account.
//  2. Device punches and attendance are separate tables. Punches are raw,
//     append-only and high-volume; a day's attendance is one derived row.
//     Keeping them apart is what makes duplicate detection, re-processing and
//     large logs tractable.
// ---------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

/// Office staff and field engineers are counted separately on the dashboard
/// and have different attendance expectations.
enum StaffCategory {
  OFFICE_STAFF
  FIELD_ENGINEER
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
}

/// Where an attendance row came from. Manual rows are the ones an audit will
/// ask about, which is why every edit is logged.
enum AttendanceSource {
  BIOMETRIC
  MANUAL
  IMPORT
}

enum PunchDirection {
  IN
  OUT
  UNKNOWN
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeDocumentKind {
  ID_PROOF
  OFFER_LETTER
  EXPERIENCE
  CERTIFICATE
  CONTRACT
  OTHER
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  headId      String?
  head        Employee? @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees    Employee[]   @relation("DepartmentMembers")
  designations Designation[]

  @@index([sortOrder])
}

model Designation {
  id           String      @id @default(cuid())
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)

  employees Employee[]

  @@unique([name, departmentId])
  @@index([departmentId])
}

model Employee {
  id           String  @id @default(cuid())
  employeeCode String  @unique
  /// Present only when the person has a login. Field staff often don't.
  userId       String? @unique
  user         User?   @relation("EmployeeAccount", fields: [userId], references: [id], onDelete: SetNull)

  name            String
  photoUrl        String?
  departmentId    String?
  department      Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  designationId   String?
  designation     Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingToId   String?
  reportingTo     Employee?    @relation("ReportingLine", fields: [reportingToId], references: [id], onDelete: SetNull)
  directReports   Employee[]   @relation("ReportingLine")
  headsDepartments Department[] @relation("DepartmentHead")

  employmentType EmploymentType @default(FULL_TIME)
  category       StaffCategory  @default(OFFICE_STAFF)
  joiningDate    DateTime
  exitDate       DateTime?
  dateOfBirth    DateTime?

  mobile                String?
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  addressLine           String?
  city                  String?
  state                 String?
  postalCode            String?

  /// The user id programmed into the biometric device. Unique because a punch
  /// is matched back to an employee by this and nothing else.
  biometricId String? @unique
  skills      String[]
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance    AttendanceRecord[]
  punches       AttendancePunch[]
  leaveRequests LeaveRequest[]     @relation("LeaveRequester")
  decidedLeave  LeaveRequest[]     @relation("LeaveDecider")
  documents     EmployeeDocument[]

  @@index([departmentId])
  @@index([category])
  @@index([isActive])
}

model EmployeeDocument {
  id         String               @id @default(cuid())
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       EmployeeDocumentKind
  title      String
  fileUrl    String
  issuedOn   DateTime?
  expiresOn  DateTime?
  createdAt  DateTime             @default(now())

  @@index([employeeId])
}

/// One row per employee per day. `date` is midnight UTC so a day is a single
/// comparable value regardless of when punches landed.
model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  checkInAt  DateTime?
  checkOutAt DateTime?
  status     AttendanceStatus
  /// Derived from the rules at write time and stored, so a later rule change
  /// never silently rewrites history that payroll has already used.
  workedMinutes   Int @default(0)
  lateMinutes     Int @default(0)
  overtimeMinutes Int @default(0)
  source     AttendanceSource @default(MANUAL)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([employeeId, date])
}

model BiometricDevice {
  id            String   @id @default(cuid())
  name          String
  model         String   @default("Team Office Z900")
  host          String
  port          Int      @default(4370)
  serialNumber  String?
  isActive      Boolean  @default(true)
  lastSyncAt    DateTime?
  lastSyncOk    Boolean?
  lastSyncNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  punches AttendancePunch[]

  @@index([isActive])
}

/// Raw device reads, append-only. The unique constraint is the duplicate
/// detection: a device that re-sends a window of punches cannot create two rows.
model AttendancePunch {
  id          String           @id @default(cuid())
  deviceId    String?
  device      BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  biometricId String
  punchedAt   DateTime
  direction   PunchDirection   @default(UNKNOWN)
  /// Set once the punch has been folded into an AttendanceRecord. Null means
  /// it still needs processing, which is also how failed rows stay visible.
  processedAt DateTime?
  employeeId  String?
  employee    Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  importNote  String?
  createdAt   DateTime         @default(now())

  @@unique([biometricId, punchedAt])
  @@index([punchedAt])
  @@index([processedAt])
  @@index([employeeId])
}

/// Attendance policy. A single active row today; the table shape leaves room
/// for per-department or shift-specific rules without a migration.
model AttendanceRule {
  id                    String   @id @default(cuid())
  name                  String   @default("Default")
  /// IANA zone the office times are written in. Stored rather than assumed:
  /// the server runs UTC, so without it "09:30" has no fixed meaning and a
  /// punch after midnight local lands on the wrong day.
  timezone              String   @default("Asia/Kolkata")
  /// "HH:mm" local time - a wall-clock policy, not an instant.
  officeStartTime       String   @default("09:30")
  officeEndTime         String   @default("18:30")
  graceMinutes          Int      @default(10)
  halfDayAfterMinutes   Int      @default(120)
  fullDayMinutes        Int      @default(480)
  halfDayMinutes        Int      @default(240)
  overtimeAfterMinutes  Int      @default(540)
  /// 0 = Sunday, matching JavaScript's getDay().
  weeklyOffDays         Int[]    @default([0])
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Holiday {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  name       String
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([date, name])
  @@index([date])
}

model LeaveType {
  id           String  @id @default(cuid())
  name         String  @unique
  code         String  @unique
  /// Days granted per calendar year. Null means uncapped (e.g. unpaid leave).
  annualQuota  Int?
  isPaid       Boolean @default(true)
  requiresAttachment Boolean @default(false)
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  requests LeaveRequest[]

  @@index([sortOrder])
}

model LeaveRequest {
  id          String             @id @default(cuid())
  employeeId  String
  employee    Employee           @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  /// Stored rather than derived: half-days and holidays mean the span alone
  /// doesn't tell you how much leave was actually consumed.
  days        Float
  reason      String
  status      LeaveRequestStatus @default(PENDING)
  attachmentUrl String?
  decidedById String?
  decidedBy   Employee?          @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

/// Who changed what, when. Platform-wide rather than attendance-only: every
/// module that grows into the ERP needs the same record, and one table means
/// one place to look during an audit.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String
  action     String
  entityType String
  entityId   String
  summary    String
  /// Only the fields that changed, so the log stays readable and small.
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}
