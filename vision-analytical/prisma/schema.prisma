// Prisma schema for the Vision Analytical platform.
// See prisma.config.ts for CLI/config wiring (Prisma 7 config format).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ENGINEER
  CUSTOMER
}

enum CategoryKind {
  INSTRUMENT
  SPARE_PART
  REFURBISHED
}

enum ProductKind {
  INSTRUMENT
  SPARE_PART
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum RefurbishedCondition {
  EXCELLENT
  GOOD
  FAIR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ServiceRequestType {
  INSTALLATION
  PREVENTIVE_MAINTENANCE
  BREAKDOWN
  CALIBRATION
  IQ
  OQ
  PQ
  VALIDATION
  SOFTWARE_INSTALL
  TRAINING
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum AmcType {
  AMC
  CMC
}

enum AmcStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
}

/// The topic a knowledge article sits under. Separate from ArticleKind: kind
/// is the *shape* of the content (a FAQ, an error code, a video), category is
/// what it is about.
/// What kind of thing an article is. Drives how it's presented and where it
/// surfaces - an ERROR_CODE article is reachable from the error-code lookup, a
/// VIDEO renders its player, a FAQ is short-form.
enum ArticleKind {
  ARTICLE
  GUIDE
  FAQ
  TROUBLESHOOTING
  ERROR_CODE
  CASE_STUDY
  VIDEO
  APPLICATION_NOTE
  INSTALLATION_GUIDE
  MAINTENANCE_GUIDE
  CALIBRATION_GUIDE
  TRAINING_GUIDE
  BEST_PRACTICE
  RELEASE_NOTE
  PRODUCT_UPDATE
}

/// How badly an error stops work. Drives ordering in the code library: an
/// instrument that won't run outranks a warning you can finish the batch with.
enum ErrorSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RETURN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  name         String
  phone        String?
  companyName  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses           Address[]
  orders              Order[]          @relation("CustomerOrders")
  quotes              Quote[]          @relation("CustomerQuotes")
  serviceRequests     ServiceRequest[] @relation("CustomerServiceRequests")
  assignedServiceJobs ServiceRequest[] @relation("EngineerServiceRequests")
  serviceReports      ServiceReport[]  @relation("EngineerServiceReports")
  amcContracts        AmcContract[]    @relation("CustomerAmcContracts")
  invoices            Invoice[]        @relation("CustomerInvoices")
  assignedLeads       CrmLead[]        @relation("AssignedLeads")
  crmActivities       CrmActivity[]    @relation("CreatedActivities")
  articles            KnowledgeArticle[] @relation("AuthoredArticles")
  reviewedArticles    KnowledgeArticle[] @relation("ReviewedArticles")
  articleRevisions    ArticleRevision[]  @relation("ArticleRevisions")
  searchQueries       SearchQuery[]      @relation("SearchQueries")
  employeeProfile     Employee?        @relation("EmployeeAccount")
  auditEntries        AuditLog[]       @relation("AuditActor")
  stockMovements      StockMovement[]  @relation("RecordedMovements")

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Manufacturers whose instruments Vision Analytical sells and services.
/// A real entity rather than a free-text field so brands can carry logos, copy
/// and SEO, own a hub page, and be filtered on across the catalogue.
model Brand {
  id             String  @id @default(cuid())
  name           String  @unique
  slug           String  @unique
  logoUrl        String?
  description    String?
  website        String?
  sortOrder      Int     @default(0)
  isPublished    Boolean @default(true)
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products               Product[]
  refurbishedInstruments RefurbishedInstrument[]
  downloads              Download[]
  instrumentModels       InstrumentModel[]
  compatibility          ProductCompatibility[]
  articleLinks           KnowledgeArticleLink[]
  errorCodes             ErrorCode[]
  serviceCases           ServiceCase[]
  symptoms               TroubleshootingSymptom[]

  @@index([sortOrder])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  // Unique per kind, not globally: "HPLC" is a valid slug for both an
  // instrument category and a refurbished-instrument category.
  slug        String
  kind        CategoryKind
  description String?
  parentId    String?
  parent      Category?    @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryToSubcategory")
  sortOrder   Int          @default(0)

  products               Product[]
  refurbishedInstruments RefurbishedInstrument[]
  downloads              Download[]
  instrumentModels       InstrumentModel[]
  knowledgeTopics        KnowledgeTopic[]

  @@unique([slug, kind])
  @@index([kind])
}

model Product {
  id               String      @id @default(cuid())
  sku              String      @unique
  slug             String      @unique
  name             String
  kind             ProductKind
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?      @relation(fields: [brandId], references: [id])
  description      String
  images           Json
  priceMinor       Int?
  stockStatus      StockStatus @default(IN_STOCK)
  stockQuantity    Int         @default(0)
  isPublished      Boolean     @default(true)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  orderItems      OrderItem[]
  quoteItems      QuoteItem[]
  stockMovements  StockMovement[]
  specifications  ProductSpecification[]
  compatibility   ProductCompatibility[]
  documents       Download[]
  articleLinks    KnowledgeArticleLink[]
  errorCodeParts  ErrorCodePart[]
  serviceCaseParts ServiceCasePart[]
  troubleshootingParts TroubleshootingCausePart[]

  @@index([kind])
  @@index([categoryId])
  @@index([brandId])
  @@index([stockStatus])
}

// ---------------------------------------------------------------------------
// Compatibility: which parts fit which instruments
// ---------------------------------------------------------------------------

/// A specific instrument a customer owns, e.g. "Alliance e2695". Spare parts
/// hang off this, and so will customer-owned instruments, calibration records
/// and service history when those modules land.
model InstrumentModel {
  id          String    @id @default(cuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  // The technique it belongs to, so a model can be browsed like a product.
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  description String?
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  compatibility ProductCompatibility[]
  articleLinks  KnowledgeArticleLink[]
  errorCodes    ErrorCode[]
  serviceCases  ServiceCase[]
  symptoms      TroubleshootingSymptom[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([categoryId])
}

/// One compatibility claim: this part fits this brand, optionally narrowed to
/// one model. A row with no model is a universal fitting ("fits Waters HPLC
/// systems generally"), which is how a lot of consumables are actually sold -
/// so the parts finder returns both model-specific and brand-wide matches.
model ProductCompatibility {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  instrumentModelId String?
  instrumentModel   InstrumentModel? @relation(fields: [instrumentModelId], references: [id], onDelete: Cascade)
  note              String?

  @@index([productId])
  @@index([brandId])
  @@index([instrumentModelId])
}

/// Structured specs rather than prose, so they can be tabulated, compared and
/// later filtered on. `group` lets a long sheet break into sections.
model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String?
  label     String
  value     String
  unit      String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model RefurbishedInstrument {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id])
  brandId             String
  brand               Brand                @relation(fields: [brandId], references: [id])
  model               String?
  condition           RefurbishedCondition
  includedAccessories String[]
  warrantyMonths      Int
  demoVideoUrl        String?
  description         String
  images              Json
  priceMinor          Int?
  stockStatus         StockStatus          @default(IN_STOCK)
  isPublished         Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  orderItems OrderItem[]
  quoteItems QuoteItem[]

  @@index([categoryId])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Commerce: quotes -> orders -> invoices
// ---------------------------------------------------------------------------

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  customerId    String?
  customer      User?       @relation("CustomerQuotes", fields: [customerId], references: [id])
  contactName   String
  contactEmail  String
  contactPhone  String?
  status        QuoteStatus @default(REQUESTED)
  validUntil    DateTime?
  totalMinor    Int?
  notes         String?
  poNumber      String?
  poDocumentUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items QuoteItem[]
  order Order?

  @@index([customerId])
  @@index([status])
}

model QuoteItem {
  id                      String                 @id @default(cuid())
  quoteId                 String
  quote                   Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  refurbishedInstrumentId String?
  refurbishedInstrument   RefurbishedInstrument? @relation(fields: [refurbishedInstrumentId], references: [id], onDelete: SetNull)
  description             String
  quantity                Int
  unitPriceMinor          Int?

  @@index([quoteId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  status          OrderStatus @default(PENDING)
  subtotalMinor   Int
  totalMinor      Int
  shippingAddress Json
  billingAddress  Json
  poNumber        String?
  poDocumentUrl   String?
  notes           String?
  sourceQuoteId   String?     @unique
  sourceQuote     Quote?      @relation(fields: [sourceQuoteId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id                      String                 @id @default(cuid())
  orderId                 String
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  refurbishedInstrumentId String?
  refurbishedInstrument   RefurbishedInstrument? @relation(fields: [refurbishedInstrumentId], references: [id], onDelete: SetNull)
  nameSnapshot            String
  skuSnapshot             String?
  unitPriceMinor          Int
  quantity                Int
  lineTotalMinor          Int

  @@index([orderId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  customer      User          @relation("CustomerInvoices", fields: [customerId], references: [id])
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  amcContractId String?
  amcContract   AmcContract?  @relation(fields: [amcContractId], references: [id])
  amountMinor   Int
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  pdfUrl        String?

  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Service: requests -> reports, AMC/CMC contracts
// ---------------------------------------------------------------------------

model ServiceRequest {
  id                    String               @id @default(cuid())
  ticketNumber          String               @unique
  customerId            String
  customer              User                 @relation("CustomerServiceRequests", fields: [customerId], references: [id])
  type                  ServiceRequestType
  priority              Priority             @default(NORMAL)
  status                ServiceRequestStatus @default(OPEN)
  instrumentDescription String
  description           String
  assignedEngineerId    String?
  assignedEngineer      User?                @relation("EngineerServiceRequests", fields: [assignedEngineerId], references: [id])
  amcContractId         String?
  amcContract           AmcContract?         @relation(fields: [amcContractId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  resolvedAt            DateTime?

  reports ServiceReport[]

  @@index([customerId])
  @@index([assignedEngineerId])
  @@index([status])
}

model ServiceReport {
  id                   String         @id @default(cuid())
  serviceRequestId     String
  serviceRequest       ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  engineerId           String
  engineer             User           @relation("EngineerServiceReports", fields: [engineerId], references: [id])
  workPerformed        String
  partsUsed            Json
  photos               Json
  customerSignatureUrl String?
  reportedAt           DateTime       @default(now())

  /// A write-up of this job, once it is worth publishing.
  serviceCase ServiceCase?

  @@index([serviceRequestId])
}

model AmcContract {
  id                    String    @id @default(cuid())
  contractNumber        String    @unique
  customerId            String
  customer              User      @relation("CustomerAmcContracts", fields: [customerId], references: [id])
  type                  AmcType
  instrumentDescription String
  startDate             DateTime
  endDate               DateTime
  visitsIncluded        Int
  visitsUsed            Int       @default(0)
  priceMinor            Int?
  status                AmcStatus @default(ACTIVE)
  createdAt             DateTime  @default(now())

  serviceRequests ServiceRequest[]
  invoices        Invoice[]

  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model CrmLead {
  id                  String        @id @default(cuid())
  name                String
  company             String?
  email               String?
  phone               String?
  source              String?
  status              CrmLeadStatus @default(NEW)
  assignedToId        String?
  assignedTo          User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes               String?
  convertedCustomerId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  activities CrmActivity[]

  @@index([status])
  @@index([assignedToId])
}

model CrmActivity {
  id          String          @id @default(cuid())
  leadId      String
  lead        CrmLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        CrmActivityType
  notes       String
  createdById String
  createdBy   User            @relation("CreatedActivities", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

/// The editorial lifecycle every piece of knowledge content moves through.
/// A two-state boolean can't express review or archival, and "archived" is not
/// the same as "never published" - the difference matters for an audit trail.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// A piece of knowledge: article, guide, FAQ, troubleshooting note, error code,
/// case study or video. Mapped to the original `BlogPost` table - the name was
/// outgrown, not the data, so this is a code-level rename with no migration.
model KnowledgeArticle {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  content        String
  kind           ArticleKind   @default(ARTICLE)
  /// What the article is *about* - HPLC, GC-MS, Balances. Separate from `kind`,
  /// which is what it *is*. The two were one field once, which left no way to
  /// say "a troubleshooting guide about HPLC".
  topicId        String?
  topic          KnowledgeTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  coverImage     String?
  /// VIDEO articles embed this; any article may also link one.
  videoUrl       String?
  /// The manufacturer's code this article explains, e.g. "E-1201". Kept for
  /// articles that predate the ErrorCode entity; new codes belong there.
  errorCode      String?
  authorId       String
  author         User          @relation("AuthoredArticles", fields: [authorId], references: [id])
  /// Who checked it. Technical content that nobody signed off on is a liability
  /// in a lab, so the reviewer is recorded rather than implied by the status.
  reviewerId     String?
  reviewer       User?         @relation("ReviewedArticles", fields: [reviewerId], references: [id], onDelete: SetNull)
  /// Bumped on every published edit, and stamped onto each revision.
  version        Int           @default(1)
  status         ContentStatus @default(DRAFT)
  /// When set in the future, the article stays hidden until that moment even at
  /// status PUBLISHED - which is what makes scheduling possible without a job
  /// runner: visibility is a query condition, not a timer.
  publishAt      DateTime?
  publishedAt    DateTime?
  reviewNote     String?
  seoTitle       String?
  seoDescription String?
  /// Feeds "popular articles". Incremented best-effort on read.
  viewCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  links       KnowledgeArticleLink[]
  tags        KnowledgeArticleTag[]
  revisions   ArticleRevision[]
  errorCodes  ErrorCode[]
  serviceCases ServiceCase[]
  troubleshootingCauses TroubleshootingCause[] @relation("CauseArticle")

  @@index([topicId])
  @@index([kind])
  @@index([status])
  @@index([publishAt])
  @@index([errorCode])
  @@index([viewCount])
  @@map("BlogPost")
}

/// What an article is about. One row per target so an article can cover a
/// brand, one of its models and a specific part at once - the same shape as
/// ProductCompatibility, for the same reason.
model KnowledgeArticleLink {
  id                String           @id @default(cuid())
  articleId         String
  article           KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  brandId           String?
  brand             Brand?           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  instrumentModelId String?
  instrumentModel   InstrumentModel? @relation(fields: [instrumentModelId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([brandId])
  @@index([instrumentModelId])
  @@index([productId])
}

/// A subject area: HPLC, GC-MS, Balances, Water Purification.
///
/// A separate taxonomy from the product `Category` tree on purpose - "Software"
/// and "General Laboratory" are things people need to read about but not things
/// we sell, and putting them in the catalogue's categories would list them on
/// shop pages. `categoryId` bridges the two where they genuinely coincide, so
/// an HPLC topic can offer "browse HPLC instruments" without duplicating it.
model KnowledgeTopic {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  /// Lucide icon name, so the hub can show a topic without an image upload.
  icon        String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles     KnowledgeArticle[]
  errorCodes   ErrorCode[]
  serviceCases ServiceCase[]
  downloads    Download[]
  symptoms     TroubleshootingSymptom[]

  @@index([sortOrder])
  @@index([isActive])
}

/// Free-form labels. Kept as rows rather than a string array so a tag can be
/// renamed once, counted, and browsed - which is what makes it useful for
/// retrieval later rather than just decoration.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles KnowledgeArticleTag[]

  @@index([slug])
}

model KnowledgeArticleTag {
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

/// A snapshot of an article as it stood before an edit.
///
/// Stored as full content rather than a diff: the point is to be able to read
/// and restore an old version months later without a patch algorithm, and
/// technical articles are small next to the cost of getting one wrong.
model ArticleRevision {
  id          String           @id @default(cuid())
  articleId   String
  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  excerpt     String
  content     String
  status      ContentStatus
  editedById  String?
  editedBy    User?            @relation("ArticleRevisions", fields: [editedById], references: [id], onDelete: SetNull)
  /// Who made the change, kept as text so the history survives the account.
  editorLabel String
  changeNote  String?
  createdAt   DateTime         @default(now())

  @@unique([articleId, version])
  @@index([articleId])
}

// ---------------------------------------------------------------------------
// Error code library
// ---------------------------------------------------------------------------

/// One manufacturer error code, with what it means and what to do about it.
///
/// An entity rather than a string on an article because an engineer standing at
/// an instrument needs the cause, the fix and the part number - not an essay.
/// The same printed code means different things on different instruments, so
/// identity is the code plus the brand and model it applies to.
model ErrorCode {
  id   String @id @default(cuid())
  /// As printed on the instrument, e.g. "E-1201".
  code String
  /// Punctuation and case stripped, so "E1201", "E-1201" and "e 1201" all
  /// match what the customer is reading off the screen.
  normalisedCode String

  brandId           String?
  brand             Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  instrumentModelId String?
  instrumentModel   InstrumentModel? @relation(fields: [instrumentModelId], references: [id], onDelete: SetNull)
  topicId           String?
  topic             KnowledgeTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  title               String
  description         String?
  possibleCauses      String?
  recommendedSolution String?
  severity            ErrorSeverity @default(MEDIUM)

  /// The deep-dive article, when one exists.
  articleId String?
  article   KnowledgeArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  videoUrl  String?

  status    ContentStatus @default(PUBLISHED)
  viewCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parts     ErrorCodePart[]
  documents ErrorCodeDocument[]
  troubleshootingCauses TroubleshootingCause[] @relation("CauseErrorCode")

  @@index([normalisedCode])
  @@index([brandId])
  @@index([instrumentModelId])
  @@index([status])
  @@index([severity])
}

/// The spare parts a fix usually needs. A code that tells you what is wrong but
/// not what to order sends the engineer back to the office.
model ErrorCodePart {
  id          String    @id @default(cuid())
  errorCodeId String
  errorCode   ErrorCode @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  note        String?

  @@unique([errorCodeId, productId])
  @@index([productId])
}

model ErrorCodeDocument {
  id          String    @id @default(cuid())
  errorCodeId String
  errorCode   ErrorCode @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)
  downloadId  String
  download    Download  @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  @@unique([errorCodeId, downloadId])
  @@index([downloadId])
}

// ---------------------------------------------------------------------------
// Service case library
// ---------------------------------------------------------------------------

/// A real job, written up so the next person doesn't rediscover it.
///
/// Optionally anchored to the ServiceReport it came from, which is what keeps
/// the library honest: a case is a published account of work that happened, not
/// a hypothetical.
model ServiceCase {
  id        String @id @default(cuid())
  reference String @unique
  slug      String @unique
  title     String

  brandId           String?
  brand             Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  instrumentModelId String?
  instrumentModel   InstrumentModel? @relation(fields: [instrumentModelId], references: [id], onDelete: SetNull)
  topicId           String?
  topic             KnowledgeTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  serviceReportId   String?          @unique
  serviceReport     ServiceReport?   @relation(fields: [serviceReportId], references: [id], onDelete: SetNull)
  articleId         String?
  article           KnowledgeArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  problem       String
  rootCause     String
  solution      String
  engineerNotes String?
  /// How long it actually took, which is what a customer asking "how long will
  /// this take" wants and what a planner needs.
  timeTakenMinutes Int?
  customerIndustry String?
  beforeImageUrl   String?
  afterImageUrl    String?
  occurredOn       DateTime?

  status    ContentStatus @default(DRAFT)
  viewCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parts ServiceCasePart[]

  @@index([brandId])
  @@index([instrumentModelId])
  @@index([topicId])
  @@index([status])
}

model ServiceCasePart {
  id            String      @id @default(cuid())
  serviceCaseId String
  serviceCase   ServiceCase @relation(fields: [serviceCaseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int         @default(1)

  @@unique([serviceCaseId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Troubleshooting wizard
// ---------------------------------------------------------------------------

/// A problem in the customer's words - "baseline drift", "no flow", "leak at
/// the pump head". The wizard walks brand → instrument → symptom, so symptoms
/// are rows an admin can add rather than branches in code.
model TroubleshootingSymptom {
  id          String @id @default(cuid())
  name        String
  slug        String
  description String?

  brandId           String?
  brand             Brand?           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  instrumentModelId String?
  instrumentModel   InstrumentModel? @relation(fields: [instrumentModelId], references: [id], onDelete: Cascade)
  topicId           String?
  topic             KnowledgeTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  causes TroubleshootingCause[]

  @@index([brandId])
  @@index([instrumentModelId])
  @@index([topicId])
  @@index([isActive])
}

/// One possible cause of a symptom, with the check that confirms it and the fix.
/// Ordered by likelihood so the wizard suggests the common case first.
model TroubleshootingCause {
  id        String                 @id @default(cuid())
  symptomId String
  symptom   TroubleshootingSymptom @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  cause      String
  howToCheck String?
  solution   String
  /// Lower is more likely, so the first suggestion is the usual answer.
  sortOrder  Int    @default(0)

  articleId   String?
  article     KnowledgeArticle? @relation("CauseArticle", fields: [articleId], references: [id], onDelete: SetNull)
  errorCodeId String?
  errorCodeRef ErrorCode?       @relation("CauseErrorCode", fields: [errorCodeId], references: [id], onDelete: SetNull)

  parts TroubleshootingCausePart[]

  @@index([symptomId])
}

model TroubleshootingCausePart {
  id      String               @id @default(cuid())
  causeId String
  cause   TroubleshootingCause @relation(fields: [causeId], references: [id], onDelete: Cascade)
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([causeId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Search analytics
// ---------------------------------------------------------------------------

/// Every search, with how many results it got.
///
/// The zero-result rows are the valuable ones: they are a list, written by
/// customers, of the content the knowledge base is missing.
model SearchQuery {
  id             String   @id @default(cuid())
  term           String
  /// Trimmed and lowercased, so "HPLC leak" and "hplc  leak" group together.
  normalisedTerm String
  resultCount    Int
  /// Which search box it came from: global, knowledge, error-codes, documents.
  source         String
  userId         String?
  user           User?    @relation("SearchQueries", fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([normalisedTerm])
  @@index([createdAt])
  @@index([resultCount])
  @@index([source])
}

// ---------------------------------------------------------------------------
// Feature flags - the admin turns modules on and off without a deploy
// ---------------------------------------------------------------------------

/// Keyed by a stable string rather than an enum: a flag is configuration, and
/// adding one should never need a migration. Unknown keys resolve to their
/// coded default, so a flag row that hasn't been seeded yet is not an outage.
model FeatureFlag {
  key         String   @id
  label       String
  description String?
  group       String
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([group, sortOrder])
}

// ---------------------------------------------------------------------------
// Site CMS - homepage sections, other page content, and site-wide settings
// editable from the admin panel without a code change. `content` fields are
// Json validated with Zod on read (see src/lib/cms/*) since Prisma can't
// express their shape at the schema level.
// ---------------------------------------------------------------------------

enum HomeSectionKey {
  HERO
  CATEGORIES
  LIFECYCLE
  WHY_US
  CTA
  COMPANY_OVERVIEW
  FEATURED_PRODUCTS
  BRANDS
  INDUSTRIES
  KNOWLEDGE
  TESTIMONIALS
  CONTACT_BAND
}

model HomeSection {
  id        String         @id @default(cuid())
  key       HomeSectionKey @unique
  isVisible Boolean        @default(true)
  sortOrder Int            @default(0)
  content   Json
  updatedAt DateTime       @updatedAt

  @@index([sortOrder])
}

enum ContentPageKey {
  ABOUT
  SERVICES
  CONTACT
  HEADER
  FOOTER
  ANNOUNCEMENT
}

model PageContent {
  id        String         @id @default(cuid())
  page      ContentPageKey @unique
  content   Json
  updatedAt DateTime       @updatedAt
}

// Singleton row (id is always the literal string "singleton").
model SiteSettings {
  id                    String   @id @default("singleton")
  companyName           String   @default("Vision Analytical")
  addressLine           String?
  city                  String?
  state                 String?
  country               String   @default("India")
  phone                 String?
  whatsappNumber        String?
  email                 String?
  facebookUrl           String?
  instagramUrl          String?
  linkedinUrl           String?
  youtubeUrl            String?
  seoDefaultTitle       String?
  seoDefaultDescription String?
  logoUrl               String?
  faviconUrl            String?
  updatedAt             DateTime @updatedAt
}

// Singleton row (id is always the literal string "singleton").
model ThemeSettings {
  id                String   @id @default("singleton")
  primaryColor      String   @default("#2563eb")
  secondaryColor    String   @default("#0891b2")
  fontHeading       String   @default("space-grotesk")
  fontBody          String   @default("inter")
  buttonStyle       String   @default("rounded")
  animationsEnabled Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Int
  reference   String?
  note        String?
  createdById String
  createdBy   User              @relation("RecordedMovements", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Knowledge assets: downloadable datasheets, manuals and certificates
// ---------------------------------------------------------------------------

enum DownloadKind {
  DATASHEET
  MANUAL
  BROCHURE
  CATALOGUE
  APPLICATION_NOTE
  CERTIFICATE
  SOFTWARE
}

model Download {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  kind        DownloadKind
  fileUrl     String
  // Null when the file is hosted off-site and we can't measure it.
  fileSizeBytes Int?
  fileType    String?
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  // Attaching a document to a product puts it on that product's page as well
  // as in the downloads centre.
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  // The subject area, so the document library can be browsed by technique.
  topicId     String?
  topic       KnowledgeTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  // Some manufacturer documents may only be released to known customers.
  requiresLogin Boolean    @default(false)
  downloadCount Int        @default(0)
  isPublished Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  errorCodeLinks ErrorCodeDocument[]

  @@index([kind])
  @@index([brandId])
  @@index([categoryId])
  @@index([productId])
  @@index([topicId])
  @@index([isPublished])
}

