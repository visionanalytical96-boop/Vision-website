// Prisma schema for the Vision Analytical platform.
// See prisma.config.ts for CLI/config wiring (Prisma 7 config format).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ENGINEER
  CUSTOMER
}

enum CategoryKind {
  INSTRUMENT
  SPARE_PART
  REFURBISHED
}

enum ProductKind {
  INSTRUMENT
  SPARE_PART
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MADE_TO_ORDER
}

enum RefurbishedCondition {
  EXCELLENT
  GOOD
  FAIR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ServiceRequestType {
  INSTALLATION
  PREVENTIVE_MAINTENANCE
  BREAKDOWN
  CALIBRATION
  IQ
  OQ
  PQ
  VALIDATION
  SOFTWARE_INSTALL
  TRAINING
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum AmcType {
  AMC
  CMC
}

enum AmcStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
}

enum BlogCategory {
  TROUBLESHOOTING
  FAQ
  TECHNICAL_ARTICLE
  INSTRUMENT_GUIDE
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RETURN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  name         String
  phone        String?
  companyName  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses           Address[]
  orders              Order[]          @relation("CustomerOrders")
  quotes              Quote[]          @relation("CustomerQuotes")
  serviceRequests     ServiceRequest[] @relation("CustomerServiceRequests")
  assignedServiceJobs ServiceRequest[] @relation("EngineerServiceRequests")
  serviceReports      ServiceReport[]  @relation("EngineerServiceReports")
  amcContracts        AmcContract[]    @relation("CustomerAmcContracts")
  invoices            Invoice[]        @relation("CustomerInvoices")
  assignedLeads       CrmLead[]        @relation("AssignedLeads")
  crmActivities       CrmActivity[]    @relation("CreatedActivities")
  blogPosts           BlogPost[]       @relation("AuthoredPosts")
  stockMovements      StockMovement[]  @relation("RecordedMovements")

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Manufacturers whose instruments Vision Analytical sells and services.
/// A real entity rather than a free-text field so brands can carry logos, copy
/// and SEO, own a hub page, and be filtered on across the catalogue.
model Brand {
  id             String  @id @default(cuid())
  name           String  @unique
  slug           String  @unique
  logoUrl        String?
  description    String?
  website        String?
  sortOrder      Int     @default(0)
  isPublished    Boolean @default(true)
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products               Product[]
  refurbishedInstruments RefurbishedInstrument[]
  downloads              Download[]
  instrumentModels       InstrumentModel[]
  compatibility          ProductCompatibility[]

  @@index([sortOrder])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  // Unique per kind, not globally: "HPLC" is a valid slug for both an
  // instrument category and a refurbished-instrument category.
  slug        String
  kind        CategoryKind
  description String?
  parentId    String?
  parent      Category?    @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryToSubcategory")
  sortOrder   Int          @default(0)

  products               Product[]
  refurbishedInstruments RefurbishedInstrument[]
  downloads              Download[]
  instrumentModels       InstrumentModel[]

  @@unique([slug, kind])
  @@index([kind])
}

model Product {
  id               String      @id @default(cuid())
  sku              String      @unique
  slug             String      @unique
  name             String
  kind             ProductKind
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?      @relation(fields: [brandId], references: [id])
  description      String
  images           Json
  priceMinor       Int?
  stockStatus      StockStatus @default(IN_STOCK)
  stockQuantity    Int         @default(0)
  isPublished      Boolean     @default(true)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  orderItems      OrderItem[]
  quoteItems      QuoteItem[]
  stockMovements  StockMovement[]
  specifications  ProductSpecification[]
  compatibility   ProductCompatibility[]
  documents       Download[]

  @@index([kind])
  @@index([categoryId])
  @@index([brandId])
  @@index([stockStatus])
}

// ---------------------------------------------------------------------------
// Compatibility: which parts fit which instruments
// ---------------------------------------------------------------------------

/// A specific instrument a customer owns, e.g. "Alliance e2695". Spare parts
/// hang off this, and so will customer-owned instruments, calibration records
/// and service history when those modules land.
model InstrumentModel {
  id          String    @id @default(cuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  // The technique it belongs to, so a model can be browsed like a product.
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  description String?
  isPublished Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  compatibility ProductCompatibility[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([categoryId])
}

/// One compatibility claim: this part fits this brand, optionally narrowed to
/// one model. A row with no model is a universal fitting ("fits Waters HPLC
/// systems generally"), which is how a lot of consumables are actually sold -
/// so the parts finder returns both model-specific and brand-wide matches.
model ProductCompatibility {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId           String
  brand             Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  instrumentModelId String?
  instrumentModel   InstrumentModel? @relation(fields: [instrumentModelId], references: [id], onDelete: Cascade)
  note              String?

  @@index([productId])
  @@index([brandId])
  @@index([instrumentModelId])
}

/// Structured specs rather than prose, so they can be tabulated, compared and
/// later filtered on. `group` lets a long sheet break into sections.
model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String?
  label     String
  value     String
  unit      String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model RefurbishedInstrument {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id])
  brandId             String
  brand               Brand                @relation(fields: [brandId], references: [id])
  model               String?
  condition           RefurbishedCondition
  includedAccessories String[]
  warrantyMonths      Int
  demoVideoUrl        String?
  description         String
  images              Json
  priceMinor          Int?
  stockStatus         StockStatus          @default(IN_STOCK)
  isPublished         Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  orderItems OrderItem[]
  quoteItems QuoteItem[]

  @@index([categoryId])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Commerce: quotes -> orders -> invoices
// ---------------------------------------------------------------------------

model Quote {
  id            String      @id @default(cuid())
  quoteNumber   String      @unique
  customerId    String?
  customer      User?       @relation("CustomerQuotes", fields: [customerId], references: [id])
  contactName   String
  contactEmail  String
  contactPhone  String?
  status        QuoteStatus @default(REQUESTED)
  validUntil    DateTime?
  totalMinor    Int?
  notes         String?
  poNumber      String?
  poDocumentUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items QuoteItem[]
  order Order?

  @@index([customerId])
  @@index([status])
}

model QuoteItem {
  id                      String                 @id @default(cuid())
  quoteId                 String
  quote                   Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  refurbishedInstrumentId String?
  refurbishedInstrument   RefurbishedInstrument? @relation(fields: [refurbishedInstrumentId], references: [id], onDelete: SetNull)
  description             String
  quantity                Int
  unitPriceMinor          Int?

  @@index([quoteId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  status          OrderStatus @default(PENDING)
  subtotalMinor   Int
  totalMinor      Int
  shippingAddress Json
  billingAddress  Json
  poNumber        String?
  poDocumentUrl   String?
  notes           String?
  sourceQuoteId   String?     @unique
  sourceQuote     Quote?      @relation(fields: [sourceQuoteId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items    OrderItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id                      String                 @id @default(cuid())
  orderId                 String
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId               String?
  product                 Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  refurbishedInstrumentId String?
  refurbishedInstrument   RefurbishedInstrument? @relation(fields: [refurbishedInstrumentId], references: [id], onDelete: SetNull)
  nameSnapshot            String
  skuSnapshot             String?
  unitPriceMinor          Int
  quantity                Int
  lineTotalMinor          Int

  @@index([orderId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  customer      User          @relation("CustomerInvoices", fields: [customerId], references: [id])
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  amcContractId String?
  amcContract   AmcContract?  @relation(fields: [amcContractId], references: [id])
  amountMinor   Int
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  pdfUrl        String?

  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Service: requests -> reports, AMC/CMC contracts
// ---------------------------------------------------------------------------

model ServiceRequest {
  id                    String               @id @default(cuid())
  ticketNumber          String               @unique
  customerId            String
  customer              User                 @relation("CustomerServiceRequests", fields: [customerId], references: [id])
  type                  ServiceRequestType
  priority              Priority             @default(NORMAL)
  status                ServiceRequestStatus @default(OPEN)
  instrumentDescription String
  description           String
  assignedEngineerId    String?
  assignedEngineer      User?                @relation("EngineerServiceRequests", fields: [assignedEngineerId], references: [id])
  amcContractId         String?
  amcContract           AmcContract?         @relation(fields: [amcContractId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  resolvedAt            DateTime?

  reports ServiceReport[]

  @@index([customerId])
  @@index([assignedEngineerId])
  @@index([status])
}

model ServiceReport {
  id                   String         @id @default(cuid())
  serviceRequestId     String
  serviceRequest       ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  engineerId           String
  engineer             User           @relation("EngineerServiceReports", fields: [engineerId], references: [id])
  workPerformed        String
  partsUsed            Json
  photos               Json
  customerSignatureUrl String?
  reportedAt           DateTime       @default(now())

  @@index([serviceRequestId])
}

model AmcContract {
  id                    String    @id @default(cuid())
  contractNumber        String    @unique
  customerId            String
  customer              User      @relation("CustomerAmcContracts", fields: [customerId], references: [id])
  type                  AmcType
  instrumentDescription String
  startDate             DateTime
  endDate               DateTime
  visitsIncluded        Int
  visitsUsed            Int       @default(0)
  priceMinor            Int?
  status                AmcStatus @default(ACTIVE)
  createdAt             DateTime  @default(now())

  serviceRequests ServiceRequest[]
  invoices        Invoice[]

  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model CrmLead {
  id                  String        @id @default(cuid())
  name                String
  company             String?
  email               String?
  phone               String?
  source              String?
  status              CrmLeadStatus @default(NEW)
  assignedToId        String?
  assignedTo          User?         @relation("AssignedLeads", fields: [assignedToId], references: [id])
  notes               String?
  convertedCustomerId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  activities CrmActivity[]

  @@index([status])
  @@index([assignedToId])
}

model CrmActivity {
  id          String          @id @default(cuid())
  leadId      String
  lead        CrmLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        CrmActivityType
  notes       String
  createdById String
  createdBy   User            @relation("CreatedActivities", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

/// The editorial lifecycle every piece of knowledge content moves through.
/// A two-state boolean can't express review or archival, and "archived" is not
/// the same as "never published" - the difference matters for an audit trail.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  content        String
  category       BlogCategory
  coverImage     String?
  authorId       String
  author         User          @relation("AuthoredPosts", fields: [authorId], references: [id])
  status         ContentStatus @default(DRAFT)
  /// When set in the future, the post stays hidden until that moment even at
  /// status PUBLISHED - which is what makes scheduling possible without a job
  /// runner: visibility is a query condition, not a timer.
  publishAt      DateTime?
  publishedAt    DateTime?
  reviewNote     String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([category])
  @@index([status])
  @@index([publishAt])
}

// ---------------------------------------------------------------------------
// Feature flags - the admin turns modules on and off without a deploy
// ---------------------------------------------------------------------------

/// Keyed by a stable string rather than an enum: a flag is configuration, and
/// adding one should never need a migration. Unknown keys resolve to their
/// coded default, so a flag row that hasn't been seeded yet is not an outage.
model FeatureFlag {
  key         String   @id
  label       String
  description String?
  group       String
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([group, sortOrder])
}

// ---------------------------------------------------------------------------
// Site CMS - homepage sections, other page content, and site-wide settings
// editable from the admin panel without a code change. `content` fields are
// Json validated with Zod on read (see src/lib/cms/*) since Prisma can't
// express their shape at the schema level.
// ---------------------------------------------------------------------------

enum HomeSectionKey {
  HERO
  CATEGORIES
  LIFECYCLE
  WHY_US
  CTA
  COMPANY_OVERVIEW
  FEATURED_PRODUCTS
  BRANDS
  INDUSTRIES
  KNOWLEDGE
  TESTIMONIALS
  CONTACT_BAND
}

model HomeSection {
  id        String         @id @default(cuid())
  key       HomeSectionKey @unique
  isVisible Boolean        @default(true)
  sortOrder Int            @default(0)
  content   Json
  updatedAt DateTime       @updatedAt

  @@index([sortOrder])
}

enum ContentPageKey {
  ABOUT
  SERVICES
  CONTACT
  HEADER
  FOOTER
  ANNOUNCEMENT
}

model PageContent {
  id        String         @id @default(cuid())
  page      ContentPageKey @unique
  content   Json
  updatedAt DateTime       @updatedAt
}

// Singleton row (id is always the literal string "singleton").
model SiteSettings {
  id                    String   @id @default("singleton")
  companyName           String   @default("Vision Analytical")
  addressLine           String?
  city                  String?
  state                 String?
  country               String   @default("India")
  phone                 String?
  whatsappNumber        String?
  email                 String?
  facebookUrl           String?
  instagramUrl          String?
  linkedinUrl           String?
  youtubeUrl            String?
  seoDefaultTitle       String?
  seoDefaultDescription String?
  logoUrl               String?
  faviconUrl            String?
  updatedAt             DateTime @updatedAt
}

// Singleton row (id is always the literal string "singleton").
model ThemeSettings {
  id                String   @id @default("singleton")
  primaryColor      String   @default("#2563eb")
  secondaryColor    String   @default("#0891b2")
  fontHeading       String   @default("space-grotesk")
  fontBody          String   @default("inter")
  buttonStyle       String   @default("rounded")
  animationsEnabled Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Int
  reference   String?
  note        String?
  createdById String
  createdBy   User              @relation("RecordedMovements", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Knowledge assets: downloadable datasheets, manuals and certificates
// ---------------------------------------------------------------------------

enum DownloadKind {
  DATASHEET
  MANUAL
  BROCHURE
  CATALOGUE
  APPLICATION_NOTE
  CERTIFICATE
  SOFTWARE
}

model Download {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  kind        DownloadKind
  fileUrl     String
  // Null when the file is hosted off-site and we can't measure it.
  fileSizeBytes Int?
  fileType    String?
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  // Attaching a document to a product puts it on that product's page as well
  // as in the downloads centre.
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Some manufacturer documents may only be released to known customers.
  requiresLogin Boolean    @default(false)
  downloadCount Int        @default(0)
  isPublished Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kind])
  @@index([brandId])
  @@index([categoryId])
  @@index([productId])
  @@index([isPublished])
}

// ---------------------------------------------------------------------------
// Misc
// ---------------------------------------------------------------------------

model Testimonial {
  id          String   @id @default(cuid())
  quote       String
  authorName  String
  authorTitle String?
  company     String?
  logoUrl     String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
}
