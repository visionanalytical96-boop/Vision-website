# Vision AutoContent Engine — configuration
#
# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env

NODE_ENV=production

# ── Server ──────────────────────────────────────────────────────────
CONTENT_ENGINE_HOST=127.0.0.1
CONTENT_ENGINE_PORT=4310
# Absolute origin used to build image URLs in the published feed.
CONTENT_ENGINE_PUBLIC_URL=https://studio.visionanalytical.in

# ── Storage ─────────────────────────────────────────────────────────
# Defaults to /srv/vision-workspace/content-engine when that path is writable.
CONTENT_ENGINE_WORKSPACE=/srv/vision-workspace/content-engine

# ── Authentication ──────────────────────────────────────────────────
# The bootstrap admin is created on first migrate, only if both are set.
CONTENT_ENGINE_ADMIN_EMAIL=
CONTENT_ENGINE_ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
CONTENT_ENGINE_SESSION_SECRET=
CONTENT_ENGINE_SESSION_TTL_HOURS=12
# Machine key for n8n. Generate with: openssl rand -hex 32
CONTENT_ENGINE_API_KEY=

# ── Rendering (CPU only — no GPU, no AI) ────────────────────────────
# auto | chromium | sharp | resvg | svg
CONTENT_ENGINE_RENDER_BACKEND=auto
# Set only if Chromium is not on a standard path.
CONTENT_ENGINE_CHROMIUM=
CONTENT_ENGINE_RENDER_TIMEOUT_MS=30000
CONTENT_ENGINE_DEFAULT_FORMAT=png
CONTENT_ENGINE_JPEG_QUALITY=90
CONTENT_ENGINE_WEBP_QUALITY=88

# ── Uploads ─────────────────────────────────────────────────────────
CONTENT_ENGINE_MAX_UPLOAD_BYTES=12582912

# ── Scheduling ──────────────────────────────────────────────────────
# In-process ticker. Leave false if n8n drives generation instead.
CONTENT_ENGINE_SCHEDULER_ENABLED=false
CONTENT_ENGINE_SCHEDULER_TICK_SECONDS=60

# ── Publishing ──────────────────────────────────────────────────────
# Master switch. While false, the scheduler generates but never publishes,
# so nothing reaches the public feed without an administrator approving it.
CONTENT_ENGINE_AUTO_PUBLISH=false
CONTENT_ENGINE_WEBSITE_FEED=true
# Optional downstream webhook (e.g. an n8n Webhook node).
CONTENT_ENGINE_PUBLISH_WEBHOOK=
CONTENT_ENGINE_PUBLISH_WEBHOOK_TOKEN=
CONTENT_ENGINE_PUBLISH_MAX_RETRIES=3

# ── Logging ─────────────────────────────────────────────────────────
CONTENT_ENGINE_LOG_LEVEL=info
CONTENT_ENGINE_LOG_RETAIN_DAYS=30

# ── Optional AI module ──────────────────────────────────────────────
# Entirely optional. Image generation never uses these; they are reserved
# for caption/SEO text assistance. The engine is fully functional with
# CONTENT_ENGINE_AI_ENABLED=false.
CONTENT_ENGINE_AI_ENABLED=false
CONTENT_ENGINE_AI_PROVIDER=
CONTENT_ENGINE_AI_ENDPOINT=
CONTENT_ENGINE_AI_API_KEY=
CONTENT_ENGINE_AI_MODEL=

# ── Instagram (optional) ────────────────────────────────────────────
# Publishing uses the official Instagram Graph API. It requires an
# Instagram *Business* or *Creator* account linked to a Facebook Page.
#
# IMPORTANT: Instagram downloads the image from CONTENT_ENGINE_PUBLIC_URL on
# its own servers, so that origin must be publicly reachable over HTTPS.
# A localhost, LAN or Tailscale-only address will not work.
CONTENT_ENGINE_IG_USER_ID=
CONTENT_ENGINE_IG_ACCESS_TOKEN=
# Only needed to refresh the token before its 60-day expiry.
CONTENT_ENGINE_IG_APP_ID=
CONTENT_ENGINE_IG_APP_SECRET=
CONTENT_ENGINE_IG_API_VERSION=v21.0
